# Set these in Vercel Project Settings -> Environment Variables.
# NEVER commit real API keys or secrets to GitHub.
# Only enable launch and direct inquiry after domain and service verification.

NEXT_PUBLIC_SITE_URL=https://www.nimofood.com
NEXT_PUBLIC_SITE_LAUNCHED=false

# Direct business inquiry integration:
# Set BOTH switches true and supply all secrets only when fully tested.
NEXT_PUBLIC_INQUIRY_FORM_ENABLED=false
INQUIRY_FORM_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Verified Resend sender identity e.g. "NIMO Inquiries <hello@your-verified-domain.tld>"
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=maakfood22@gmail.com
